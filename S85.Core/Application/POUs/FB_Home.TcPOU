<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Home" Id="{052f8c26-c1a2-4f4d-af1e-ff6466264bfd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Home

VAR_INPUT
	stInputs : ST_HomeInputs;
    stCommand : ST_LightCommand;
END_VAR

VAR_OUTPUT
	stOutputs : ST_HomeOutputs;
    aLights : ARRAY[1..6] OF ST_LightInfo;
    bCatalogReady : BOOL;
    nLightCount : DINT := 0;
END_VAR

VAR
    fbWorkshop : FB_Location_Workshop;
    fbEntryway : FB_Location_Entryway;
    fbHall : FB_Location_Hall;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbWorkshop(
    stInputs := stInputs.Workshop,
    stCommand := stCommand,
    stOutputs => stOutputs.Workshop
);

fbEntryway(
    stInputs := stInputs.Entryway,
    bHallLowerButton := stInputs.Hall.bLowerButton,
    stCommand := stCommand,
    stOutputs => stOutputs.Entryway
);

fbHall(
    stInputs := stInputs.Hall,
    stCommand := stCommand,
    stOutputs => stOutputs.Hall
);

bCatalogReady := FALSE;
aLights[1] := fbWorkshop.stLight;
aLights[2] := fbEntryway.aLights[1];
aLights[3] := fbEntryway.aLights[2];
aLights[4] := fbHall.aLights[1];
aLights[5] := fbHall.aLights[2];
aLights[6] := fbHall.aLights[3];
nLightCount := UPPER_BOUND(aLights, 1) - LOWER_BOUND(aLights, 1) + 1;
bCatalogReady := TRUE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
