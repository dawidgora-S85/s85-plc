<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Location_Workshop" Id="{ed6140a9-7ba0-4913-8278-e47fbcd68c6d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Location_Workshop
VAR_INPUT
    stInputs : ST_WorkshopInputs;
    stCommand : ST_LightCommand;
END_VAR

VAR_OUTPUT
    stOutputs : ST_WorkshopOutputs;
    stLight : ST_LightInfo;
END_VAR

VAR CONSTANT
    cLocationId : STRING(16) := 'H.01-09';
    cMainLightId : STRING(16) := 'main';
END_VAR

VAR
    fbWorkshop : FB_ButtonLight;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbWorkshop(
    bButton := stInputs.bButton,
    bAdditionalButton := FALSE,
    bSetValid := stCommand.bValid AND (stCommand.sLocationId = cLocationId) AND (stCommand.sLightId = cMainLightId),
    bTargetOn := stCommand.bTargetOn,
    bLightRelay => stOutputs.bLightRelay
);

stLight.sLocationId := cLocationId;
stLight.sId := cMainLightId;
stLight.bOn := stOutputs.bLightRelay;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
