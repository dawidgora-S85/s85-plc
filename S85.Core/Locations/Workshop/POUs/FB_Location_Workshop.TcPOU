<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Location_Workshop" Id="{ed6140a9-7ba0-4913-8278-e47fbcd68c6d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Location_Workshop
VAR_INPUT
    stInputs : ST_WorkshopInputs;
END_VAR

VAR_OUTPUT
    stOutputs : ST_WorkshopOutputs;
END_VAR

VAR
    fbWorkshop : FB_Workshop;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbWorkshop(
    bButton := stInputs.bButton,
    bLightRelay => stOutputs.bLightRelay
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
