<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Location_Entryway" Id="{f7521329-8123-44c1-8539-6a0ef925431d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Location_Entryway
VAR_INPUT
    stInputs : ST_EntrywayInputs;
    bHallLowerButton : BOOL;
    stCommand : ST_LightCommand;
END_VAR

VAR_OUTPUT
    stOutputs : ST_EntrywayOutputs;
    aLights : ARRAY[1..2] OF ST_LightInfo;
END_VAR

VAR CONSTANT
    cLocationId : STRING(16) := 'H.01-01';
    {attribute 'TcEncoding' := 'UTF-8'}
    cLocationName : STRING(64) := UTF8#'Wiatrołap';
    cMainLightId : STRING(16) := 'main';
    {attribute 'TcEncoding' := 'UTF-8'}
    cMainLightName : STRING(64) := UTF8#'Oświetlenie główne';
    cTemporaryLightId : STRING(16) := 'temporary';
    {attribute 'TcEncoding' := 'UTF-8'}
    cTemporaryLightName : STRING(64) := UTF8#'Oświetlenie tymczasowe';
END_VAR

VAR
    fbLowerLight : FB_ButtonLight;
    fbUpperLight : FB_ButtonLight;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbLowerLight(
    bButton := stInputs.bLowerButton,
    bAdditionalButton := bHallLowerButton,
    bSetValid := stCommand.bValid AND (stCommand.sLocationId = cLocationId) AND (stCommand.sLightId = cMainLightId),
    bTargetOn := stCommand.bTargetOn,
    bLightRelay => stOutputs.bLightRelay
);

fbUpperLight(
    bButton := stInputs.bUpperButton,
    bAdditionalButton := FALSE,
    bSetValid := stCommand.bValid AND (stCommand.sLocationId = cLocationId) AND (stCommand.sLightId = cTemporaryLightId),
    bTargetOn := stCommand.bTargetOn,
    bLightRelay => stOutputs.bTemporaryLightRelay
);

aLights[1].sLocationId := cLocationId;
aLights[1].sLocationName := cLocationName;
aLights[1].sId := cMainLightId;
aLights[1].sName := cMainLightName;
aLights[1].bOn := stOutputs.bLightRelay;
aLights[2].sLocationId := cLocationId;
aLights[2].sLocationName := cLocationName;
aLights[2].sId := cTemporaryLightId;
aLights[2].sName := cTemporaryLightName;
aLights[2].bOn := stOutputs.bTemporaryLightRelay;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
