<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Location_Entryway" Id="{f7521329-8123-44c1-8539-6a0ef925431d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Location_Entryway
VAR_INPUT
    stInputs : ST_EntrywayInputs;
END_VAR

VAR_OUTPUT
    stOutputs : ST_EntrywayOutputs;
END_VAR

VAR
    fbMainLight : FB_Workshop;
    fbUpperLight : FB_Workshop;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbMainLight(
    bButton := stInputs.bButton,
    bLightRelay => stOutputs.bLightRelay
);

fbUpperLight(
    bButton := stInputs.bUpperButton,
    bLightRelay => stOutputs.bTemporaryLightRelay
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
