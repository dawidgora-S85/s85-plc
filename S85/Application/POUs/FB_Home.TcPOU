<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Home" Id="{052f8c26-c1a2-4f4d-af1e-ff6466264bfd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Home

VAR_INPUT
	stInputs : ST_HomeInputs;
END_VAR

VAR_IN_OUT
	stOutputs : ST_HomeOutputs;
END_VAR

VAR
    fbWorkshop : FB_Location_Workshop;
    i : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[FOR i := 1 TO GVL_HomeLimits.cMaxLights DO
    stOutputs.aLights[i].bValid := FALSE;
    stOutputs.aLights[i].bOn := FALSE;
END_FOR

fbWorkshop(
    stInputs := stInputs,
    stOutputs := stOutputs
);]]></ST>
    </Implementation>
    <Method Name="RegisterLights" Id="{c23d2613-6f8d-4c0d-9ae8-f2f8721a8d13}">
      <Declaration><![CDATA[METHOD PUBLIC RegisterLights : BOOL
VAR_IN_OUT
    fbCatalog : FB_LightCatalog;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[RegisterLights := fbWorkshop.RegisterLights(fbCatalog := fbCatalog);]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
