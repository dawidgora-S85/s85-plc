<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{4bca9e79-1877-4bca-8065-d77b30175a3b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbHome : FB_Home;
    fbHardwareInputs : FB_HardwareInputs;
    fbHardwareOutputs : FB_HardwareOutputs;
    fbSimulationInputs : FB_SimulationInputs;
    fbSimulationOutputs : FB_SimulationOutputs;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{IF defined (WORKSHOP_HW)}
    {IF defined (WORKSHOP_SIM)}
        {error 'Define exactly one of WORKSHOP_HW or WORKSHOP_SIM'}
    {END_IF}
{ELSE}
    {IF defined (WORKSHOP_SIM)}
    {ELSE}
        {error 'Define exactly one of WORKSHOP_HW or WORKSHOP_SIM'}
    {END_IF}
{END_IF}

{IF defined (WORKSHOP_HW)}
fbHardwareInputs(stInputs => stInputs);
{ELSE}
fbSimulationInputs(stInputs => stInputs);
{END_IF}

fbHome(
    stInputs := stInputs,
    stOutputs => stOutputs
);

{IF defined (WORKSHOP_HW)}
fbHardwareOutputs(stOutputs := stOutputs);
{ELSE}
fbSimulationOutputs(stOutputs := stOutputs);
{END_IF}]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
