<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{4bca9e79-1877-4bca-8065-d77b30175a3b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbWorkshop : FB_Workshop;
    fbEntryway : FB_Workshop;
    fbEntrywayUpperButton : FB_Workshop;
    bWorkshopButton : BOOL;
    bEntrywayButton : BOOL;
    bEntrywayUpperButton : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{IF defined (WORKSHOP_HW)}
    {IF defined (WORKSHOP_SIM)}
        {error 'Define exactly one of WORKSHOP_HW or WORKSHOP_SIM'}
    {END_IF}
{ELSE}
    {IF defined (WORKSHOP_SIM)}
    {ELSE}
        {error 'Define exactly one of WORKSHOP_HW or WORKSHOP_SIM'}
    {END_IF}
{END_IF}

{IF defined (WORKSHOP_HW)}
bWorkshopButton := GVL_WorkshopIO.bButton;
bEntrywayButton := GVL_EntrywayIO.bButton;
bEntrywayUpperButton := GVL_EntrywayIO.bUpperButton;
{ELSE}
bWorkshopButton := GVL_WorkshopSimulation.bButton;
bEntrywayButton := GVL_EntrywaySimulation.bButton;
bEntrywayUpperButton := GVL_EntrywaySimulation.bUpperButton;
{END_IF}

fbWorkshop(
    bButton := bWorkshopButton
);
fbEntryway(
    bButton := bEntrywayButton
);
fbEntrywayUpperButton(
    bButton := bEntrywayUpperButton
);

{IF defined (WORKSHOP_HW)}
GVL_WorkshopIO.bLightRelay := fbWorkshop.bLightRelay;
GVL_EntrywayIO.bLightRelay := fbEntryway.bLightRelay;
GVL_EntrywayIO.bTemporaryLightRelay := fbEntrywayUpperButton.bLightRelay;
{ELSE}
GVL_WorkshopSimulation.bLightRelay := fbWorkshop.bLightRelay;
GVL_EntrywaySimulation.bLightRelay := fbEntryway.bLightRelay;
GVL_EntrywaySimulation.bTemporaryLightRelay := fbEntrywayUpperButton.bLightRelay;
{END_IF}]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
