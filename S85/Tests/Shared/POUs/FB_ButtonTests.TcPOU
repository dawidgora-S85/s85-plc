<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ButtonTests" Id="{41457a8d-b22e-406e-9d0d-93adb71265d2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ButtonTests EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ShortPressOnRelease();
LongPressOnRelease();
AutoCommitLongPressWhileHeld();
AutoCommitFiresOnlyOnce();
ReleaseAfterAutoCommitDoesNotFireAgain();]]></ST>
    </Implementation>
    <Method Name="AutoCommitFiresOnlyOnce" Id="{19477a51-2573-4755-beb6-6a2026a8a48f}">
      <Declaration><![CDATA[METHOD PRIVATE AutoCommitFiresOnlyOnce
VAR_INST
    fbButton : FB_Button;
    fbWait : TON;
    nLongPressCount : USINT;
    nStep : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto commit fires only once while held');

CASE nStep OF

    0:
        fbWait(IN := FALSE);
        nLongPressCount := 0;

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        nStep := 1;

    1:
        fbWait(
            IN := TRUE,
            PT := T#150MS
        );

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        IF fbButton.bLongPress THEN
            nLongPressCount := nLongPressCount + 1;
        END_IF

        IF fbWait.Q THEN
            AssertTrue(
                Condition := nLongPressCount = 1,
                Message := 'Auto commit should fire exactly once while held'
            );

            TEST_FINISHED();
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="AutoCommitLongPressWhileHeld" Id="{18a767fc-12d4-4c23-b26c-0f7d4fefea0a}">
      <Declaration><![CDATA[METHOD PRIVATE AutoCommitLongPressWhileHeld
VAR_INST
    fbButton : FB_Button;
    fbWait : TON;
    nStep : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto commit fires long press while held');

CASE nStep OF

    0:
        fbWait(IN := FALSE);

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        nStep := 1;

    1:
        fbWait(
            IN := TRUE,
            PT := T#100MS
        );

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        IF fbButton.bLongPress THEN
            AssertFalse(
                Condition := fbButton.bShortPress,
                Message := 'Short press must not fire on auto commit'
            );

            TEST_FINISHED();

        ELSIF fbWait.Q THEN
            AssertTrue(
                Condition := FALSE,
                Message := 'Auto commit did not fire long press'
            );

            TEST_FINISHED();
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="LongPressOnRelease" Id="{6954a4b4-297c-4054-9753-3462e2cb2bf0}">
      <Declaration><![CDATA[METHOD PRIVATE LongPressOnRelease
VAR_INST
    fbButton : FB_Button;
    fbWait : TON;
    nStep : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Long press fires on release after qualification');

CASE nStep OF
    0:
        fbWait(IN := FALSE);

        fbButton(
            bPressed := TRUE,
            tLongPress := T#50MS,
            tAutoCommit := T#500MS
        );

        nStep := 1;

    1:
        fbWait(
            IN := TRUE,
            PT := T#75MS
        );

        fbButton(
            bPressed := TRUE,
            tLongPress := T#50MS,
            tAutoCommit := T#500MS
        );

        IF fbWait.Q THEN
            AssertFalse(
                Condition := fbButton.bLongPress,
                Message := 'Long press should not fire before release'
            );

            fbWait(IN := FALSE);
            nStep := 2;
        END_IF

    2:
        fbButton(
            bPressed := FALSE,
            tLongPress := T#50MS,
            tAutoCommit := T#500MS
        );

        AssertTrue(
            Condition := fbButton.bLongPress,
            Message := 'Long press should fire on release'
        );

        AssertFalse(
            Condition := fbButton.bShortPress,
            Message := 'Short press should not fire after long press'
        );

        TEST_FINISHED();

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseAfterAutoCommitDoesNotFireAgain" Id="{57ddd2a2-ef41-4873-b328-f5a9a46eea91}">
      <Declaration><![CDATA[METHOD PRIVATE ReleaseAfterAutoCommitDoesNotFireAgain
VAR_INST
    fbButton : FB_Button;
    fbWait : TON;
    nStep : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Release after auto commit does not fire again');

CASE nStep OF

    0:
        fbWait(IN := FALSE);

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        nStep := 1;

    1:
        fbWait(
            IN := TRUE,
            PT := T#100MS
        );

        fbButton(
            bPressed := TRUE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        IF fbButton.bLongPress THEN
            nStep := 2;

        ELSIF fbWait.Q THEN
            AssertTrue(
                Condition := FALSE,
                Message := 'Auto commit did not occur before timeout'
            );

            TEST_FINISHED();
        END_IF

    2:
        fbButton(
            bPressed := FALSE,
            tLongPress := T#20MS,
            tAutoCommit := T#50MS
        );

        AssertFalse(
            Condition := fbButton.bLongPress,
            Message := 'Release must not fire long press again after auto commit'
        );

        AssertFalse(
            Condition := fbButton.bShortPress,
            Message := 'Release must not fire short press after auto commit'
        );

        TEST_FINISHED();

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ShortPressOnRelease" Id="{ec2ea299-b9fb-4284-9a02-5535ac62537f}">
      <Declaration><![CDATA[METHOD PRIVATE ShortPressOnRelease
VAR_INST
    fbButton : FB_Button;
    nStep : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Short press fires on release');

CASE nStep OF
    0:
        fbButton(
            bPressed := TRUE,
            tLongPress := T#1S,
            tAutoCommit := T#2S
        );

        nStep := 1;

    1:
        fbButton(
            bPressed := FALSE,
            tLongPress := T#1S,
            tAutoCommit := T#2S
        );

        AssertTrue(
            Condition := fbButton.bShortPress,
            Message := 'Short press should fire on release'
        );

        AssertFalse(
            Condition := fbButton.bLongPress,
            Message := 'Long press should not fire for a short press'
        );

        TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>