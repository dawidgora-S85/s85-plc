<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_WorkshopTests" Id="{90a1b664-843b-4411-bfd7-ff975b7a2f83}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_WorkshopTests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ButtonStartupAndPressHoldReleaseRepress();]]></ST>
    </Implementation>
    <Method Name="ButtonStartupAndPressHoldReleaseRepress" Id="{4f6ac5c4-e847-48eb-bfd8-00ed1a35bd19}">
      <Declaration><![CDATA[METHOD PRIVATE ButtonStartupAndPressHoldReleaseRepress
VAR
    fbWorkshop : FB_Workshop;
    fbStartupHigh : FB_Workshop;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Workshop button startup and toggle sequence');

fbStartupHigh(bButton := TRUE);
AssertFalse(
    Condition := fbStartupHigh.bLightRelay,
    Message := 'Relay starts OFF and startup-high button is ignored'
);
fbStartupHigh(bButton := FALSE);
fbStartupHigh(bButton := TRUE);
AssertTrue(
    Condition := fbStartupHigh.bLightRelay,
    Message := 'Startup-high input toggles only after release and new press'
);

fbWorkshop(bButton := FALSE);
AssertFalse(
    Condition := fbWorkshop.bLightRelay,
    Message := 'Initial low input leaves the relay OFF'
);

fbWorkshop(bButton := TRUE);
AssertTrue(
    Condition := fbWorkshop.bLightRelay,
    Message := 'New press turns the relay ON'
);

fbWorkshop(bButton := TRUE);
AssertTrue(
    Condition := fbWorkshop.bLightRelay,
    Message := 'Holding the button does not toggle again'
);

fbWorkshop(bButton := FALSE);
AssertTrue(
    Condition := fbWorkshop.bLightRelay,
    Message := 'Release leaves the relay ON'
);

fbWorkshop(bButton := TRUE);
AssertFalse(
    Condition := fbWorkshop.bLightRelay,
    Message := 'Next press turns the relay OFF'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
