<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LightTests" Id="{c5856838-1d6b-4b34-b900-07483f8bff5f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LightTests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ToggleTurnsLightOn();
SecondToggleTurnsLightOff();
NoToggleKeepsCurrentState();
HeldToggleTogglesEveryCycle();]]></ST>
    </Implementation>
    <Method Name="HeldToggleTogglesEveryCycle" Id="{371fc64a-d964-4d52-8a5d-8e401ded155e}">
      <Declaration><![CDATA[METHOD PRIVATE HeldToggleTogglesEveryCycle
VAR
	fbLight : FB_Light;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Held toggle toggles every cycle');

fbLight.bToggle := TRUE;
fbLight();

AssertTrue(
    Condition := fbLight.bOn,
    Message := 'Light should be ON after first cycle with toggle held'
);

fbLight();

AssertFalse(
    Condition := fbLight.bOn,
    Message := 'Light should be OFF after second cycle with toggle still held'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="NoToggleKeepsCurrentState" Id="{3f7c2d53-b707-4069-ae01-d00505e72865}">
      <Declaration><![CDATA[METHOD NoToggleKeepsCurrentState
VAR
    fbLight : FB_Light;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No toggle keeps current state');

fbLight.bToggle := FALSE;
fbLight();

AssertFalse(
    Condition := fbLight.bOn,
    Message := 'Light should remain OFF without toggle'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SecondToggleTurnsLightOff" Id="{8b0859e6-a360-4010-b172-3025a975b5c7}">
      <Declaration><![CDATA[METHOD PRIVATE SecondToggleTurnsLightOff
VAR
    fbLight : FB_Light;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Second toggle turns light off');

fbLight.bToggle := TRUE;
fbLight();

fbLight.bToggle := FALSE;
fbLight();

fbLight.bToggle := TRUE;
fbLight();

AssertFalse(
    Condition := fbLight.bOn,
    Message := 'Light should be OFF after second toggle'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToggleTurnsLightOn" Id="{0219653a-ebc7-4f44-b312-192b3fedd447}">
      <Declaration><![CDATA[METHOD PRIVATE ToggleTurnsLightOn
VAR
    fbLight : FB_Light;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Toggle turns light on');

fbLight.bToggle := TRUE;
fbLight();

AssertTrue(
    Condition := fbLight.bOn,
    Message := 'Light should be ON after toggle'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>