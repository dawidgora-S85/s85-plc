<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_DummyRoom" Id="{33979f5c-881e-401e-b0e7-434bc2e0e976}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DummyRoom
VAR_INPUT
    stInputs : ST_DummyRoomInputs;
END_VAR

VAR_OUTPUT
    stOutputs : ST_DummyRoomOutputs;
END_VAR

VAR
    fbButton : FB_Button;
	fbLight1 : FB_Light;
	fbLight2 : FB_Light;
	
	bAnyLightOn : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbButton(
    bPressed := stInputs.bButton
);

bAnyLightOn := fbLight1.bOn OR fbLight2.bOn;

fbLight1(
    bToggle := fbButton.bShortPress
        AND (NOT bAnyLightOn OR fbLight1.bOn)
);

fbLight2(
    bToggle := (fbButton.bShortPress AND fbLight2.bOn)
        OR fbButton.bLongPress
);

stOutputs.bLight1 := fbLight1.bOn;
stOutputs.bLight2 := fbLight2.bOn;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>