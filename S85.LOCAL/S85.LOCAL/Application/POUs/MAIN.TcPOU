<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{2f735285-04b2-4c14-80fd-338b9c439d52}">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbHome : FB_Home;
    {attribute 'TcNoSymbol'}
    fbMqttIntegration : FB_MqttIntegration;
    {attribute 'TcNoSymbol'}
    fbMqttConfigLoader : FB_MqttConfigLoader;
    fbSimulationInputs : FB_SimulationInputs;
    fbSimulationOutputs : FB_SimulationOutputs;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    {attribute 'TcNoSymbol'}
    stMqttConfig : ST_MqttConfig;
    stLightCommand : ST_LightCommand;
    bHomeInitialized : BOOL;
    bMqttReady : BOOL;
    bMqttError : BOOL;
    nMqttConfigError : UDINT;
    nMqttSystemError : UDINT;
    hrMqttError : HRESULT;
    nMqttRejectedQueue : UDINT;
    nMqttRejectedMessages : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbSimulationInputs(
    bWorkshopButton := GVL_WorkshopSimulation.bButton,
    bEntrywayLowerButton := GVL_EntrywaySimulation.bLowerButton,
    bEntrywayUpperButton := GVL_EntrywaySimulation.bUpperButton,
    bHallUpperButton := GVL_HallSimulation.bUpperButton,
    bHallLowerButton := GVL_HallSimulation.bLowerButton,
    stInputs => stInputs
);

fbMqttConfigLoader.Cycle(
    sConfigFilePath := 'C:\ProgramData\S85\config\mqtt.conf',
    sSecretsFilePath := 'C:\ProgramData\S85\secrets\mqtt.conf'
);
    fbMqttConfigLoader.GetConfig(stResult := stMqttConfig);
fbMqttIntegration(bTestNamespace := TRUE);

IF bHomeInitialized THEN
    fbMqttIntegration.ReceiveCycle(
        aLights := fbHome.aLights,
        stConfig := stMqttConfig,
        bConfigurationReady := fbMqttConfigLoader.bReady,
        bCatalogReady := fbHome.bCatalogReady,
        nLightCount := 3
    );
    stLightCommand := fbMqttIntegration.PopCommand();
ELSE
    stLightCommand.bValid := FALSE;
END_IF

fbHome(
    stInputs := stInputs,
    stCommand := stLightCommand,
    stOutputs => stOutputs
);
bHomeInitialized := TRUE;

fbSimulationOutputs(
    stOutputs := stOutputs,
    bWorkshopLightRelay := GVL_WorkshopSimulation.bLightRelay,
    bEntrywayLightRelay := GVL_EntrywaySimulation.bLightRelay,
    bEntrywayTemporaryLightRelay := GVL_EntrywaySimulation.bTemporaryLightRelay,
    bHallOuterSpotsRelay := GVL_HallSimulation.bOuterSpotsRelay,
    bHallMiddleSpotRelay := GVL_HallSimulation.bMiddleSpotRelay
);

IF bHomeInitialized THEN
    fbMqttIntegration.PublishCycle(aLights := fbHome.aLights, bCatalogReady := fbHome.bCatalogReady, nLightCount := 3);
END_IF

bMqttReady := fbMqttIntegration.bReady;
bMqttError := fbMqttConfigLoader.bError OR fbMqttIntegration.bError OR fbMqttIntegration.bConfigurationError;
nMqttConfigError := fbMqttConfigLoader.nErrorCode;
nMqttSystemError := fbMqttConfigLoader.nSystemErrorCode;
hrMqttError := fbMqttIntegration.hrErrorCode;
nMqttRejectedQueue := fbMqttIntegration.nRejectedQueue;
nMqttRejectedMessages := fbMqttIntegration.nRejectedMessages;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
