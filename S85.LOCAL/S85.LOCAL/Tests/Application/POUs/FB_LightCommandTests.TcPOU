<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LightCommandTests" Id="{34a8a44c-7195-45ad-9fc9-531de9037237}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LightCommandTests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[AllThreeRoutesAreAbsoluteAndIndependent();
HallToggleCoversEveryMemberCombination();
HallUpperToggleWinsOverEverySet();
InvalidCommandsDoNothing();
DuplicateSetIsIdempotent();
PhysicalPressWinsOverSet();
StartupHighAndCommandValidity();]]></ST>
    </Implementation>
    <Method Name="AllThreeRoutesAreAbsoluteAndIndependent" Id="{ef78e31d-e847-4e59-ac81-65ed5ad8d81c}">
      <Declaration><![CDATA[METHOD PRIVATE AllThreeRoutesAreAbsoluteAndIndependent
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Absolute commands route ON and OFF independently across the six-light catalog');

stCommand.bValid := TRUE;
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn AND NOT fbHome.aLights[2].bOn AND NOT fbHome.aLights[3].bOn, Message := 'Workshop main ON routes only to Workshop');
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[1].bOn, Message := 'Workshop main OFF is absolute');

stCommand.sLocationId := 'H.01-01';
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[1].bOn AND fbHome.aLights[2].bOn AND NOT fbHome.aLights[3].bOn, Message := 'Entryway main ON routes only to Entryway main');
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[2].bOn, Message := 'Entryway main OFF is absolute');

stCommand.sLightId := 'temporary';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[1].bOn AND NOT fbHome.aLights[2].bOn AND fbHome.aLights[3].bOn, Message := 'Entryway temporary ON routes only to temporary light');
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[3].bOn, Message := 'Entryway temporary OFF is absolute');

stCommand.sLocationId := 'H.01-02';
stCommand.sLightId := 'outer_spots';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[5].bOn AND NOT fbHome.aLights[6].bOn AND fbHome.aLights[4].bOn, Message := 'Hall outer spot ON is independent and group derives ON');
stCommand.sLightId := 'middle_spot';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stCommand.sLightId := 'outer_spots';
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[5].bOn AND fbHome.aLights[6].bOn AND fbHome.aLights[4].bOn, Message := 'Outer spot OFF leaves middle spot and group ON');
stCommand.sLightId := 'outer_spots';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[5].bOn AND fbHome.aLights[6].bOn AND fbHome.aLights[4].bOn, Message := 'Outer spot ON leaves middle spot on');
stCommand.sLightId := 'middle_spot';
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[5].bOn AND NOT fbHome.aLights[6].bOn AND fbHome.aLights[4].bOn, Message := 'Middle spot OFF leaves outer spot and group ON');
stCommand.sLightId := 'outer_spots';
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[6].bOn AND NOT fbHome.aLights[5].bOn AND NOT fbHome.aLights[4].bOn, Message := 'Last member OFF clears derived group');
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[5].bOn AND fbHome.aLights[6].bOn AND fbHome.aLights[4].bOn, Message := 'Duplicate Hall group ON remains absolute');
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[5].bOn AND NOT fbHome.aLights[6].bOn AND NOT fbHome.aLights[4].bOn, Message := 'Duplicate Hall group OFF remains absolute');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="InvalidCommandsDoNothing" Id="{bf28a4fb-c9b3-40a1-a8b0-1a794e8bb96c}">
      <Declaration><![CDATA[METHOD PRIVATE InvalidCommandsDoNothing
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Invalid flag, location, and light IDs do not change any output');

stCommand.bValid := TRUE;
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stCommand.bValid := FALSE;
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn, Message := 'Invalid flag does not clear Workshop main');

stCommand.bValid := TRUE;
stCommand.sLocationId := 'bad-location';
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn AND NOT fbHome.aLights[2].bOn AND NOT fbHome.aLights[3].bOn, Message := 'Unknown location does not route');
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'bad-light';
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn AND NOT fbHome.aLights[2].bOn AND NOT fbHome.aLights[3].bOn, Message := 'Unknown light does not route');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="DuplicateSetIsIdempotent" Id="{cc254ed4-490b-4a21-9452-e2a85ac83c01}">
      <Declaration><![CDATA[METHOD PRIVATE DuplicateSetIsIdempotent
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Repeated absolute SET does not toggle the light');

stCommand.bValid := TRUE;
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn, Message := 'Duplicate ON remains ON');
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertFalse(Condition := fbHome.aLights[1].bOn, Message := 'Duplicate OFF remains OFF');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="PhysicalPressWinsOverSet" Id="{107e9022-ae50-4a70-b473-12cae86eeb32}">
      <Declaration><![CDATA[METHOD PRIVATE PhysicalPressWinsOverSet
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Physical press toggles previous state instead of applying simultaneous SET');

stInputs.Workshop.bButton := FALSE;
stCommand.bValid := TRUE;
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'main';
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stInputs.Workshop.bButton := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn, Message := 'Press from OFF wins over simultaneous SET OFF');

stInputs.Workshop.bButton := FALSE;
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stInputs.Workshop.bButton := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertFalse(Condition := fbHome.aLights[1].bOn, Message := 'Press from ON wins over simultaneous SET ON');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="StartupHighAndCommandValidity" Id="{667d37c7-3812-474f-b2af-22adbc9671a2}">
      <Declaration><![CDATA[METHOD PRIVATE StartupHighAndCommandValidity
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Startup-high is ignored and invalid command is not held for later scans');

stInputs.Workshop.bButton := TRUE;
stCommand.bValid := FALSE;
stCommand.sLocationId := 'H.01-09';
stCommand.sLightId := 'main';
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertFalse(Condition := fbHome.aLights[1].bOn, Message := 'Startup-high button does not toggle');
stInputs.Workshop.bButton := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertFalse(Condition := fbHome.aLights[1].bOn, Message := 'Invalid command remains unapplied on release');
stInputs.Workshop.bButton := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn, Message := 'A fresh press toggles after startup-high release');
stInputs.Workshop.bButton := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stCommand.bValid := TRUE;
stCommand.bTargetOn := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stCommand.bValid := FALSE;
stCommand.bTargetOn := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[1].bOn, Message := 'Invalid command does not reapply stale OFF target');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="HallToggleCoversEveryMemberCombination" Id="{d4937fa2-a705-4e90-8f5e-801d1c6504c3}">
      <Declaration><![CDATA[METHOD PRIVATE HallToggleCoversEveryMemberCombination
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
    nMask : INT;
    bOuterInitial : BOOL;
    bMiddleInitial : BOOL;
    bExpected : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Hall upper toggles both members from all four pre-scan combinations and arms after release');

stInputs.Hall.bUpperButton := TRUE;
stCommand.bValid := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := NOT fbHome.aLights[5].bOn AND NOT fbHome.aLights[6].bOn, Message := 'Startup-high Hall upper remains suppressed while held');
stInputs.Hall.bUpperButton := FALSE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
stInputs.Hall.bUpperButton := TRUE;
fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
AssertTrue(Condition := fbHome.aLights[5].bOn AND fbHome.aLights[6].bOn, Message := 'Hall upper toggles both after startup-high release and new press');

FOR nMask := 0 TO 3 DO
    stCommand.bValid := TRUE;
    stCommand.sLocationId := 'H.01-02';
    stCommand.sLightId := 'outer_spots';
    bOuterInitial := (nMask MOD 2) = 1;
    bMiddleInitial := nMask >= 2;
    stCommand.bTargetOn := bOuterInitial;
    fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
    stCommand.sLightId := 'middle_spot';
    stCommand.bTargetOn := bMiddleInitial;
    fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);

    stCommand.bValid := FALSE;
    stInputs.Hall.bUpperButton := FALSE;
    fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
    bExpected := NOT (bOuterInitial OR bMiddleInitial);
    stInputs.Hall.bUpperButton := TRUE;
    fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
    AssertTrue(Condition := (fbHome.aLights[5].bOn = bExpected) AND (fbHome.aLights[6].bOn = bExpected), Message := 'Hall upper toggle sets both members from the pre-scan any-on state');
    AssertTrue(Condition := fbHome.aLights[4].bOn = bExpected, Message := 'Hall group snapshot follows both members');
    fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
    AssertTrue(Condition := (fbHome.aLights[5].bOn = bExpected) AND (fbHome.aLights[6].bOn = bExpected), Message := 'Held Hall upper does not toggle again');
END_FOR
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="HallUpperToggleWinsOverEverySet" Id="{0f650d3c-4954-4a1e-a6ea-1c13081b9d72}">
      <Declaration><![CDATA[METHOD PRIVATE HallUpperToggleWinsOverEverySet
VAR
    fbHome : FB_Home;
    stInputs : ST_HomeInputs;
    stOutputs : ST_HomeOutputs;
    stCommand : ST_LightCommand;
    nOuterInitial : INT;
    nMiddleInitial : INT;
    nRoute : INT;
    nTarget : INT;
    bExpected : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Hall upper physical toggle has priority over simultaneous group and member SET commands');

FOR nOuterInitial := 0 TO 1 DO
    FOR nMiddleInitial := 0 TO 1 DO
        FOR nRoute := 1 TO 3 DO
            FOR nTarget := 0 TO 1 DO
                stCommand.bValid := TRUE;
                stCommand.sLocationId := 'H.01-02';
                stCommand.sLightId := 'outer_spots';
                stCommand.bTargetOn := nOuterInitial = 1;
                fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
                stCommand.sLightId := 'middle_spot';
                stCommand.bTargetOn := nMiddleInitial = 1;
                fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);

                stInputs.Hall.bUpperButton := FALSE;
                stCommand.bValid := FALSE;
                fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);

                CASE nRoute OF
                    1: stCommand.sLightId := 'main';
                    2: stCommand.sLightId := 'outer_spots';
                    3: stCommand.sLightId := 'middle_spot';
                END_CASE
                stCommand.bValid := TRUE;
                stCommand.bTargetOn := nTarget = 1;
                stInputs.Hall.bUpperButton := TRUE;
                fbHome(stInputs := stInputs, stCommand := stCommand, stOutputs => stOutputs);
                bExpected := NOT ((nOuterInitial = 1) OR (nMiddleInitial = 1));
                AssertTrue(Condition := (fbHome.aLights[5].bOn = bExpected) AND (fbHome.aLights[6].bOn = bExpected), Message := 'Physical toggle wins over same-scan SET for group or either member');
            END_FOR
        END_FOR
    END_FOR
END_FOR
TEST_FINISHED();]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
