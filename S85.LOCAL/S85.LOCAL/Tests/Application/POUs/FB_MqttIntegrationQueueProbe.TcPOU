      <Implementation><ST><![CDATA[fbDiscovery.bTestNamespace := bTestNamespace;
ObserveDiscoveryForTest := ObserveDiscovery(sObservedTopic := sTopic, pObservedPayload := ADR(sPayload), nObservedPayloadSize := nPayloadSize, bPayloadValid := TRUE);
]]></ST></Implementation>
    </Method>
