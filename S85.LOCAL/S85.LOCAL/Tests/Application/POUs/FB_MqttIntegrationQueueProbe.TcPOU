    <Method Name="ReceiveCommandForTest" Id="{4bdca2c7-1163-4db6-9799-127479f07bed}">
      <Declaration><![CDATA[METHOD PUBLIC ReceiveCommandForTest : BOOL
VAR_INPUT
    sTopic : STRING(255);
    sPayload : STRING(8);
    nPayloadSize : UDINT;
END_VAR
VAR_IN_OUT
    aLights : ARRAY[*] OF ST_LightInfo;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[ReceiveCommandForTest := ReceiveLightCommand(sCommandTopic := sTopic, sCommandPayload := sPayload, nCommandPayloadSize := nPayloadSize, aLights := aLights);]]></ST></Implementation>
    </Method>
    <Method Name="ReceiveRoutedCommandForTest" Id="{a28416dd-a3d5-49ca-8b82-68bb2b62acba}">
      <Declaration><![CDATA[METHOD PUBLIC ReceiveRoutedCommandForTest : BOOL
VAR_INPUT
    sTopic : STRING(255);
    sPayload : STRING(8);
    nPayloadSize : UDINT;
END_VAR
VAR_IN_OUT
    aLights : ARRAY[*] OF ST_LightInfo;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[ReceiveRoutedCommandForTest := FALSE;
IF CanReceiveCommand() THEN
    ReceiveRoutedCommandForTest := ReceiveLightCommand(sCommandTopic := sTopic, sCommandPayload := sPayload, nCommandPayloadSize := nPayloadSize, aLights := aLights);
END_IF]]></ST></Implementation>
    </Method>
