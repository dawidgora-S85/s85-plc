    <Method Name="PlanSnapshotForTest" Id="{b6cc627f-5e49-4654-ac37-07e6c8bfce20}">
      <Declaration><![CDATA[METHOD PUBLIC PlanSnapshotForTest : BOOL
VAR_IN_OUT
