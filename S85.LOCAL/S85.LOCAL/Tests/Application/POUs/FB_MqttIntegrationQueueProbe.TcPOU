    </Method>
    <Method Name="ReconcileMetadataForTest" Id="{80e23e77-e51f-4af0-b985-59056e2c25ca}">
      <Declaration><![CDATA[METHOD PUBLIC ReconcileMetadataForTest : BOOL
VAR_IN_OUT
    aLights : ARRAY[*] OF ST_LightInfo;
END_VAR
VAR_OUTPUT
    bPlanValid : BOOL;
    bPlanPending : BOOL;
    sTopic : STRING(255);
    sPayload : STRING(2047);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[fbDiscovery.bTestNamespace := bTestNamespace;
ReconcileMetadataForTest := ReconcileDiscoveryPlan(
    aLights := aLights,
    bPlanValid => bPlanValid,
    bPlanPending => bPlanPending,
    sPlannedTopic => sTopic,
    sPlannedPayload => sPayload
);]]></ST></Implementation>
    </Method>
    <Method Name="ObserveDiscoveryForTest" Id="{2c38b6de-a231-4feb-a4c9-087b2f2f6081}">
      <Declaration><![CDATA[METHOD PUBLIC ObserveDiscoveryForTest : BOOL
VAR_INPUT
    sTopic : STRING(255);
