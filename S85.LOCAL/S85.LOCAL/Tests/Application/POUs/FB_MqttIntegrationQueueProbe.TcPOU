    sTopic : STRING(255);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[fbDiscovery.bTestNamespace := bTestNamespace;
ObserveDiscovery(sObservedTopic := sTopic, pObservedPayload := 0, nObservedPayloadSize := 2048, bPayloadValid := FALSE);
]]></ST></Implementation>
    </Method>
