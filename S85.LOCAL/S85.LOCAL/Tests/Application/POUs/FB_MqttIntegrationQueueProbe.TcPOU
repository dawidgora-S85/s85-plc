  <POU Name="FB_MqttIntegrationQueueProbe" Id="{dff8de19-a022-41af-9e1d-fc1f561c42ac}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MqttIntegrationQueueProbe EXTENDS S85Core.FB_MqttIntegration
