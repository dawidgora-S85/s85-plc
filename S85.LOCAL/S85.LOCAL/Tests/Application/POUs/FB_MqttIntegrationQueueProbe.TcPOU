    </Method>
    <Method Name="InjectAvailabilityOutcome" Id="{a3903309-f52c-49c2-b31d-bffc2a445831}">
      <Declaration><![CDATA[METHOD PUBLIC InjectAvailabilityOutcome : BOOL
VAR_INPUT
    nGeneration : UDINT;
    bAccepted : BOOL;
    bOnline : BOOL;
    bPublishError : BOOL;
    bActualConnected : BOOL;
    bLogicalConnected : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[InjectAvailabilityOutcome := HandleAvailabilityOutcome(
    nAttemptGeneration := nGeneration,
    bAccepted := bAccepted,
    bOnline := bOnline,
    bPublishError := bPublishError,
    bActualConnected := bActualConnected,
    bLogicalConnected := bLogicalConnected
);]]></ST></Implementation>
    </Method>
    <Method Name="SetOutcomeContextForTest" Id="{850ba9d6-1ee9-43ab-bf66-cb752a8d8ebc}">
      <Declaration><![CDATA[METHOD PUBLIC SetOutcomeContextForTest
VAR_INPUT
    ePhase : E_MqttLifecyclePhase;
    bConnectedForTest : BOOL;
    bQueueResetForTest : BOOL;
    bSubscriptionsForTest : BOOL;
    bDisconnectFenceForTest : BOOL;
    bSessionRejectedForTest : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[eLifecyclePhase := ePhase;
bConnected := bConnectedForTest;
bQueueResetComplete := bQueueResetForTest;
bSubscriptionsAccepted := bSubscriptionsForTest;
bDisconnectForQueue := bDisconnectFenceForTest;
bSessionPresentRejected := bSessionRejectedForTest;
bError := FALSE;
bReady := FALSE;
UpdateCommandReadiness();]]></ST></Implementation>
    </Method>
    <Method Name="ClearCommandCoverageFenceForTest" Id="{a5469d93-4c24-44ad-a9bd-882d24b412aa}">
      <Declaration><![CDATA[METHOD PUBLIC ClearCommandCoverageFenceForTest]]></Declaration>
      <Implementation><ST><![CDATA[bCommandCoverageFence := FALSE;
UpdateCommandReadiness();]]></ST></Implementation>
    </Method>
    <Method Name="SyncReadinessForTest" Id="{f80f94a6-8c50-4a0a-9f7f-7110f0527882}">
      <Declaration><![CDATA[METHOD PUBLIC SyncReadinessForTest]]></Declaration>
      <Implementation><ST><![CDATA[UpdateCommandReadiness();]]></ST></Implementation>
    </Method>
    <Method Name="BirthRefreshActiveForTest" Id="{f3262e8d-e25f-4e0f-9c83-1b5309217f30}">
      <Declaration><![CDATA[METHOD PUBLIC BirthRefreshActiveForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[BirthRefreshActiveForTest := bBirthRefreshActive;]]></ST></Implementation>
    </Method>
    <Method Name="DiscoveryReadyForTest" Id="{7ef8a440-97c3-49d5-99a6-7db9b31ca85a}">
      <Declaration><![CDATA[METHOD PUBLIC DiscoveryReadyForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[DiscoveryReadyForTest := fbDiscovery.bReady;]]></ST></Implementation>
    </Method>
    <Method Name="OnlineAcceptedForTest" Id="{6a2b84e2-8ddb-481b-aeb8-317e8d80f6a6}">
      <Declaration><![CDATA[METHOD PUBLIC OnlineAcceptedForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[OnlineAcceptedForTest := bOnlineAccepted;]]></ST></Implementation>
    </Method>
    <Method Name="ConnectedSessionStableForTest" Id="{516fd74e-cd4c-4554-b51a-f6e0b325c3a3}">
      <Declaration><![CDATA[METHOD PUBLIC ConnectedSessionStableForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[ConnectedSessionStableForTest := bConnected AND bQueueResetComplete AND bSubscriptionsAccepted AND NOT bDisconnectForQueue AND NOT bSessionPresentRejected;]]></ST></Implementation>
    </Method>
    <Method Name="DisconnectForTest" Id="{0bd2c597-27d4-4eef-bd27-0e8379d2e8ea}">
      <Declaration><![CDATA[METHOD PUBLIC DisconnectForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[DisconnectForTest := bDisconnectForQueue;]]></ST></Implementation>
    </Method>
    <Method Name="RecoveryRequestedForTest" Id="{bf21bca7-4bb2-474f-af83-01630f8e9c84}">
      <Declaration><![CDATA[METHOD PUBLIC RecoveryRequestedForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[RecoveryRequestedForTest := fbDiscovery.bCoverageRecoveryRequested;]]></ST></Implementation>
    </Method>
    <Method Name="CoverageReplayStartedForTest" Id="{118d67c4-77b5-445c-8f30-075862790a22}">
      <Declaration><![CDATA[METHOD PUBLIC CoverageReplayStartedForTest]]></Declaration>
      <Implementation><ST><![CDATA[fbDiscovery.CoverageReplayStarted();
SyncCoverageFault();]]></ST></Implementation>
    </Method>
    <Method Name="UnexpectedObservationForTest" Id="{c4494425-d336-4fea-9635-149c2d441f1c}">
      <Declaration><![CDATA[METHOD PUBLIC UnexpectedObservationForTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[UnexpectedObservationForTest := fbDiscovery.bUnexpectedObservation;]]></ST></Implementation>
    </Method>
    <Method Name="EstablishReadyForBirthTest" Id="{e0d06d59-3f8f-423b-8728-5d20962d4e07}">
      <Declaration><![CDATA[METHOD PUBLIC EstablishReadyForBirthTest : BOOL
VAR_IN_OUT
    aLights : ARRAY[*] OF ST_LightInfo;
END_VAR
VAR
    bPlanValid : BOOL;
    bPlanPending : BOOL;
    sPlannedTopic : STRING(255);
    sPlannedPayload : STRING(2047);
    bStatePending : BOOL;
    nPayloadLength : UDINT;
    nPayloadScan : UDINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[EstablishReadyForBirthTest := FALSE;
fbDiscovery.bTestNamespace := bTestNamespace;
IF NOT ReconcileDiscoveryPlan(aLights := aLights, bPlanValid => bPlanValid, bPlanPending => bPlanPending, sPlannedTopic => sPlannedTopic, sPlannedPayload => sPlannedPayload) THEN RETURN; END_IF
IF bPlanPending THEN
    ConfirmDiscoveryOutcome(bAccepted := TRUE, bPublishError := FALSE);
    nPayloadLength := SIZEOF(sPlannedPayload);
    FOR nPayloadScan := 0 TO SIZEOF(sPlannedPayload) - 1 DO
        IF sPlannedPayload[nPayloadScan] = 0 THEN nPayloadLength := nPayloadScan; EXIT; END_IF
    END_FOR
    ObserveDiscovery(sObservedTopic := sPlannedTopic, pObservedPayload := ADR(sPlannedPayload), nObservedPayloadSize := nPayloadLength, bPayloadValid := TRUE);
END_IF
IF NOT ReconcileDiscoveryPlan(aLights := aLights, bPlanValid => bPlanValid, bPlanPending => bPlanPending, sPlannedTopic => sPlannedTopic, sPlannedPayload => sPlannedPayload) OR NOT fbDiscovery.bReady THEN RETURN; END_IF
SetOutcomeContextForTest(ePhase := E_MqttLifecyclePhase.OfflineFence, bConnectedForTest := TRUE, bQueueResetForTest := TRUE, bSubscriptionsForTest := FALSE, bDisconnectFenceForTest := FALSE, bSessionRejectedForTest := FALSE);
IF NOT InjectAvailabilityOutcome(nGeneration := nLifecycleGeneration, bAccepted := TRUE, bOnline := FALSE, bPublishError := FALSE, bActualConnected := TRUE, bLogicalConnected := TRUE) THEN RETURN; END_IF
IF NOT PlanCurrentState(aLights := aLights) THEN RETURN; END_IF
ConfirmStateOutcome(bAccepted := TRUE);
bStatePending := PlanCurrentState(aLights := aLights);
IF bStatePending THEN RETURN; END_IF
SetOutcomeContextForTest(ePhase := E_MqttLifecyclePhase.OnlineAnnouncement, bConnectedForTest := TRUE, bQueueResetForTest := TRUE, bSubscriptionsForTest := TRUE, bDisconnectFenceForTest := FALSE, bSessionRejectedForTest := FALSE);
IF NOT InjectAvailabilityOutcome(nGeneration := nLifecycleGeneration, bAccepted := TRUE, bOnline := TRUE, bPublishError := FALSE, bActualConnected := TRUE, bLogicalConnected := TRUE) THEN RETURN; END_IF
UpdateCommandReadiness();
EstablishReadyForBirthTest := TRUE;]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
